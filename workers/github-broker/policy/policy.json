{
  "$comment": "Who may do what, where. Validated against @custodes/schema Policy at startup. Every change is a reviewed PR. Signing keys are generated by the broker's Keyring; the only per-agent secret is the PAT.",
  "version": 1,
  "agents": {
    "hello": {
      "tokenBinding": "PAT_HELLO",
      "mode": "hitl",
      "repos": ["OWASP/CheatSheetSeries"],
      "actions": ["issue.comment"],
      "requiresApproval": [],
      "rateLimitPerHour": 5
    }
  },
  "reads": {
    "triage": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries"],
      "resources": ["issues", "labels", "cheatsheets", "timeline"]
    },
    "implementation-check": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries"],
      "resources": ["issue", "timeline", "pull_files", "cheatsheets", "cheatsheet"]
    },
    "proposal-review": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries"],
      "resources": ["issue", "comments", "labels", "cheatsheets", "cheatsheet"]
    }
  }
}
