{
  "$comment": "Who may do what, where. Validated against @custodes/schema Policy at startup. Every change is a reviewed PR. Signing keys are generated by the broker's Keyring; the only per-agent secret is the PAT.",
  "version": 1,
  "agents": {
    "hello": {
      "tokenBinding": "PAT_HELLO",
      "mode": "hitl",
      "repos": ["OWASP/CheatSheetSeries"],
      "actions": ["issue.comment"],
      "requiresApproval": [],
      "rateLimitPerHour": 5
    },
    "pr-gate": {
      "$comment": "ADR 0011: closes community PRs that break CONTRIBUTING.md, with a signed comment. hotl; the agent also caps itself at 10 closes per UTC day.",
      "tokenBinding": "PAT_PR_GATE",
      "mode": "hotl",
      "repos": ["OWASP/CheatSheetSeries", "mackowski/custodes-sandbox"],
      "actions": ["pr.close"],
      "requiresApproval": [],
      "rateLimitPerHour": 5
    },
    "cheatsheet-review": {
      "$comment": "ADR 0017: multi-model review of a pull request when the operator adds the trigger label; posts one review with inline suggestions (never APPROVE) and removes the label. hotl because every run is started by the operator; sandbox only until its evals pass.",
      "tokenBinding": "PAT_CHEATSHEET_REVIEW",
      "mode": "hotl",
      "repos": ["mackowski/custodes-sandbox"],
      "actions": ["pr.review.inline", "issue.label.remove"],
      "requiresApproval": [],
      "rateLimitPerHour": 20
    }
  },
  "reads": {
    "triage": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries", "mackowski/custodes-sandbox"],
      "resources": ["issues", "labels", "cheatsheets", "timeline"]
    },
    "implementation-check": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries", "mackowski/custodes-sandbox"],
      "resources": ["issue", "timeline", "pull_files", "cheatsheets", "cheatsheet"]
    },
    "proposal-review": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries", "mackowski/custodes-sandbox"],
      "resources": ["issue", "comments", "timeline", "labels", "cheatsheets", "cheatsheet"]
    },
    "pr-gate": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["OWASP/CheatSheetSeries", "mackowski/custodes-sandbox"],
      "resources": ["pulls", "pull_files", "issue", "issues", "comments"]
    },
    "cheatsheet-review": {
      "tokenBinding": "PAT_READONLY",
      "repos": ["mackowski/custodes-sandbox"],
      "resources": [
        "pull",
        "pull_files",
        "pull_file_at_ref",
        "timeline",
        "issue",
        "cheatsheets",
        "cheatsheet"
      ]
    }
  }
}
