{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "custodes-github-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Not reachable from the internet: only via service bindings from gateway and agents.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "prod",
    "VERIFY_URL": "https://custodes.work/verify",
    // The broker verifies the operator's own Cloudflare Access token on every admin write instead
    // of trusting the gateway (#104). Same values as the gateway's (bindings.test pins that).
    "ACCESS_TEAM": "ai-custodes",
    "ACCESS_AUD": "0cb7808f9edd99f93ee4cb7ee333f46eb7ee2ad9cc8abd4a05667344cd8c595e",
    "APPROVER_EMAILS": "jkb.mackowski@gmail.com",
  },
  // Per-agent Ed25519 signing keys are generated and held by this Durable Object; private keys never leave it.
  "durable_objects": { "bindings": [{ "name": "KEYRING", "class_name": "Keyring" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Keyring"] }],
  "kv_namespaces": [{ "binding": "KILL_SWITCH", "id": "841e2b0dd14d48fbac292217839957a4" }],
  // cheatsheet_search (ADR 0023): GitHub code search allows 10 requests a minute per account, shared
  // with the operator. All agents together (one key) at most 5 a minute; read.ts refuses search without it.
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "1323", "simple": { "limit": 5, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "AUDIT",
      "database_name": "custodes-audit",
      "database_id": "bdce4844-0c8c-46e4-ab90-8ec98df7234a",
      "migrations_dir": "migrations",
    },
  ],
  // One GitHub PAT per agent, pushed into Secrets Store by CI from the GitHub secret PAT_<AGENT>.
  // Binding names must match policy/policy.json tokenBinding.
  "secrets_store_secrets": [
    // pr-gate: fine-grained, OWASP/CheatSheetSeries only, Pull requests: read & write (ADR 0011).
    {
      "binding": "PAT_PR_GATE",
      "store_id": "92c5c38062fc4da98fad1fe4f5a8bda1",
      "secret_name": "github-pat-pr-gate",
    },
    // cheatsheet-review: classic public_repo PAT like pr-gate (sandbox and OWASP, ADR 0017); the
    // policy limits it to pr.review.inline (approved per review on OWASP) and its trigger label.
    {
      "binding": "PAT_CHEATSHEET_REVIEW",
      "store_id": "92c5c38062fc4da98fad1fe4f5a8bda1",
      "secret_name": "github-pat-cheatsheet-review",
    },
    // triage-apply (ADR 0019): classic public_repo PAT on account mackowski (admin on OWASP; OWASP
    // allows no fine-grained token); the policy allows assign, labels and comments on the sandbox
    // and OWASP, each only after the operator approves the bundle.
    {
      "binding": "PAT_TRIAGE_APPLY",
      "store_id": "92c5c38062fc4da98fad1fe4f5a8bda1",
      "secret_name": "github-pat-triage-apply",
    },
    // Read-only PAT (public repositories only, no permissions) for agent reads via /v1/read.
    {
      "binding": "PAT_READONLY",
      "store_id": "92c5c38062fc4da98fad1fe4f5a8bda1",
      "secret_name": "github-pat-readonly",
    },
  ],
}
