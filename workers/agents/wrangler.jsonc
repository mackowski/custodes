{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "custodes-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Agents are reached through the gateway (Access) or by schedule/queue/e-mail, never directly.
  "workers_dev": false,
  "preview_urls": false,
  // Logs as before; traces feed the Agents dashboard (ADR 0016).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "vars": {
    "ENVIRONMENT": "prod",
    "AI_GATEWAY_ACCOUNT_ID": "5f62912564df344533c9563904c77662",
    "AI_GATEWAY_ID": "custodes",
    "EMAIL_FROM": "custodes@custodes.work",
    "EMAIL_DOMAIN": "custodes.work",
    // Recipient of digests. Must be a verified Email Routing destination (infra/terraform email module).
    "OPERATOR_EMAIL": "jkb.mackowski@gmail.com",
    // NO EFFECT HERE since pr-gate's cutover: pr-gate reads PR_GATE_ENFORCE and JEV_* from
    // workers/pr-gate/wrangler.jsonc. Kept only so the generated Env type still has them; the
    // clean-up PR removes them (docs/runbooks/agent-cutover.md).
    "PR_GATE_ENFORCE": "true",
    "JEV_TRANSPORT": "direct",
    "JEV_GATEWAY_PATH": "api/alpha/decisions",
    // Records model and tool payloads (prompts, issue and PR text) in trace spans (ADR 0016).
    // Credentials and error text are never recorded. "false" keeps spans metadata-only.
    "TRACE_PAYLOADS": "true",
    // Approval links in e-mails (ADR 0017 amendment): the gateway page behind Cloudflare Access.
    "APPROVAL_LINK_BASE": "https://custodes.work/admin/approvals/link",
  },
  // Secrets (set by CI on deploy): AI_GATEWAY_TOKEN (cheatsheet-review). OPENROUTER_API_KEY is
  // removed by deploy-workers since pr-gate moved.
  "durable_objects": {
    "bindings": [
      // triage and its specialists moved to custodes-triage on 2026-11-12 (ADR 0018, cutover).
      // pr-gate moved to custodes-pr-gate (ADR 0018, cutover; see scripts/agent-moves.json).
      // hotl: multi-model review when the operator labels a PR (ADR 0017, broker policy cheatsheet-review).
      { "name": "CheatsheetReviewAgent", "class_name": "CheatsheetReviewAgent" },
    ],
  },
  // Durable Object classes, declaratively (ADR 0018): replaces the old `migrations` tags v1..v5.
  // One-way: once deployed with `exports`, this Worker cannot go back to `migrations`.
  "exports": {
    // The hello smoke-test agent is removed with its stored data (#103).
    "HelloAgent": { "type": "durable-object", "state": "deleted" },
    // Moved with their data to custodes-triage (ADR 0018, cutover 2026-11-12). The classes stay in
    // this Worker's code for now: Cloudflare supports a `transferred` tombstone next to an exported
    // class; a later PR removes both.
    "TriageAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-triage",
    },
    "ImplementationCheckAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-triage",
    },
    "ProposalReviewAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-triage",
    },
    "PrGateAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-pr-gate",
    },
    "CheatsheetReviewAgent": { "type": "durable-object", "storage": "sqlite" },
  },
  // Must match CRON_TRIAGE_POLL / CRON_TRIAGE_PREPARE / CRON_TRIAGE_DIGEST in src/index.ts (UTC).
  // Since the triage and pr-gate cutovers nothing here runs on them (both skip when unbound); they
  // run in custodes-triage and custodes-pr-gate. The clean-up PR removes them.
  "triggers": { "crons": ["17 */4 * * *", "30 5 * * *", "0 7 * * *"] },
  // Workers AI, for Clef (shadow decision model, ADR 0015) and cheatsheet-review's DeepSeek models
  // (ADR 0017). Every call names the "custodes" AI Gateway (ClefClient and WorkersAiChat require it):
  // all agent model traffic goes through one gateway.
  "ai": { "binding": "AI", "remote": true },
  // No KILL_SWITCH binding: a KV binding can write, so an agent could clear its own halt flag.
  // Agents read their state from the broker (/v1/state); only the broker and gateway bind it.
  "services": [{ "binding": "BROKER", "service": "custodes-github-broker" }],
  "queues": {
    "consumers": [
      {
        "queue": "custodes-inbound",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "custodes-inbound-dlq",
      },
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Agents may only e-mail the operators. Widen deliberately, per agent, in a reviewed PR.
      "allowed_destination_addresses": ["jkb.mackowski@gmail.com"],
    },
  ],
}
