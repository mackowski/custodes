{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "custodes-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Agents are reached through the gateway (Access) or by schedule/queue/e-mail, never directly.
  "workers_dev": false,
  "preview_urls": false,
  // Logs as before; traces feed the Agents dashboard (ADR 0016).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "vars": {
    "ENVIRONMENT": "prod",
    "AI_GATEWAY_ACCOUNT_ID": "5f62912564df344533c9563904c77662",
    "AI_GATEWAY_ID": "custodes",
    "EMAIL_FROM": "custodes@custodes.work",
    "EMAIL_DOMAIN": "custodes.work",
    // Recipient of digests. Must be a verified Email Routing destination (infra/terraform email module).
    "OPERATOR_EMAIL": "jkb.mackowski@gmail.com",
    // pr-gate closes pull requests while this is "true" (ADR 0011). "false" is a soft stop: it keeps
    // evaluating and only reports what it would close. The hard stop is the kill switch.
    "PR_GATE_ENFORCE": "true",
    // Jev transport (ADR 0011). AI Gateway's openrouter provider returns 404 for OpenRouter's
    // /api/alpha/decisions (Diagnose run 38715467646, 2026-10-15), so Jev is called directly with
    // the OPENROUTER_API_KEY Worker secret (set by CI). Switch to "gateway" when it is supported.
    "JEV_TRANSPORT": "direct",
    "JEV_GATEWAY_PATH": "api/alpha/decisions",
    // Records model and tool payloads (prompts, issue and PR text) in trace spans (ADR 0016).
    // Credentials and error text are never recorded. "false" keeps spans metadata-only.
    "TRACE_PAYLOADS": "true",
  },
  // Secrets (set by CI on deploy): AI_GATEWAY_TOKEN, APPROVAL_TOKEN_SECRET, OPENROUTER_API_KEY
  "durable_objects": {
    "bindings": [
      { "name": "HelloAgent", "class_name": "HelloAgent" },
      { "name": "TriageAgent", "class_name": "TriageAgent" },
      // Specialists triage delegates to over RPC (read-only, own broker read policy each).
      { "name": "ImplementationCheckAgent", "class_name": "ImplementationCheckAgent" },
      { "name": "ProposalReviewAgent", "class_name": "ProposalReviewAgent" },
      // hotl: closes community PRs that break CONTRIBUTING.md (broker policy pr-gate).
      { "name": "PrGateAgent", "class_name": "PrGateAgent" },
      // hotl: multi-model review when the operator labels a PR (ADR 0017, broker policy cheatsheet-review).
      { "name": "CheatsheetReviewAgent", "class_name": "CheatsheetReviewAgent" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HelloAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["TriageAgent"] },
    { "tag": "v3", "new_sqlite_classes": ["ImplementationCheckAgent", "ProposalReviewAgent"] },
    { "tag": "v4", "new_sqlite_classes": ["PrGateAgent"] },
    { "tag": "v5", "new_sqlite_classes": ["CheatsheetReviewAgent"] },
  ],
  // Must match CRON_TRIAGE_POLL / CRON_TRIAGE_PREPARE / CRON_TRIAGE_DIGEST in src/index.ts (UTC).
  // pr-gate shares them (polls on the first two, summary with the digest).
  "triggers": { "crons": ["17 */4 * * *", "30 5 * * *", "0 7 * * *"] },
  // Workers AI, for Clef (shadow decision model, ADR 0015) and cheatsheet-review's DeepSeek models
  // (ADR 0017). Every call names the "custodes" AI Gateway (ClefClient and WorkersAiChat require it):
  // all agent model traffic goes through one gateway.
  "ai": { "binding": "AI", "remote": true },
  "kv_namespaces": [{ "binding": "KILL_SWITCH", "id": "841e2b0dd14d48fbac292217839957a4" }],
  "services": [{ "binding": "BROKER", "service": "custodes-github-broker" }],
  "queues": {
    "consumers": [
      {
        "queue": "custodes-inbound",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "custodes-inbound-dlq",
      },
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Agents may only e-mail the operators. Widen deliberately, per agent, in a reviewed PR.
      "allowed_destination_addresses": ["jkb.mackowski@gmail.com"],
    },
  ],
}
