{
  "$schema": "node_modules/wrangler/config-schema.json",
  // custodes-agents (ADR 0018). Every agent runs in its own Worker since the cutovers
  // (workers/triage, workers/triage-apply, workers/pr-gate, workers/cheatsheet-review); they bundle
  // their code from `src/` here, deployed with `-c ../<agent>/wrangler.jsonc`. This Worker runs no
  // agent: no Durable Object, no secret, no cron, no queue, no service, AI or e-mail binding. It
  // answers only GET /registry (the gateway's /admin/agents) and /healthz, from `src/index.ts`.
  "name": "custodes-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the gateway (Access), never directly.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Durable Object classes, declaratively (ADR 0018). One-way: once deployed with `exports`, this
  // Worker cannot go back to `migrations`. Only tombstones are left: the namespaces (with their
  // data) belong to the Workers named below, or are gone. The classes are no longer in this Worker's
  // code. Do not re-declare a name here without checking who owns the namespace
  // (scripts/do-namespace-owner.ts, run by deploy-workers). Drop a tombstone only after Cloudflare
  // reports it stale (the `stale_tombstone` notice on deploy); the deploy guard reads the
  // `transferred` entries to know which moves are done (scripts/agent-cutover-config.ts moved).
  "exports": {
    // The hello smoke-test agent was removed with its stored data (#103).
    "HelloAgent": { "type": "durable-object", "state": "deleted" },
    "TriageAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-triage",
    },
    "ImplementationCheckAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-triage",
    },
    "ProposalReviewAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-triage",
    },
    "PrGateAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-pr-gate",
    },
    "CheatsheetReviewAgent": {
      "type": "durable-object",
      "state": "transferred",
      "transferred_to": "custodes-cheatsheet-review",
    },
  },
}
