{
  "$schema": "node_modules/wrangler/config-schema.json",
  // custodes-agents (ADR 0018). Every agent runs in its own Worker since the cutovers
  // (workers/triage, workers/triage-apply, workers/pr-gate, workers/cheatsheet-review); they bundle
  // their code from `src/` here, deployed with `-c ../<agent>/wrangler.jsonc`. This Worker runs no
  // agent: no Durable Object, no secret, no cron, no queue, no service, AI or e-mail binding (the
  // queue consumer and the secrets are removed by deploy-workers, which deploys never do). It
  // answers only GET /registry (the gateway's /admin/agents) and /healthz, from `src/index.ts`.
  "name": "custodes-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the gateway (Access), never directly.
  "workers_dev": false,
  "preview_urls": false,
  // Empty, not absent: with no `triggers` key a deploy leaves the Worker's existing crons in place
  // (review of #122, M1), and this Worker has no `scheduled` handler any more.
  "triggers": { "crons": [] },
  // agent.md and context files are bundled as text (ADR 0023). Only backlog-review imports them;
  // here for the tests, which run with this file.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Durable Object classes, declaratively (ADR 0018). One-way: once deployed with `exports`, this
  // Worker cannot go back to `migrations`, so the key stays, empty. Every class moved out with its
  // data (custodes-triage, custodes-pr-gate, custodes-cheatsheet-review) or was deleted (HelloAgent,
  // #103); their tombstones were dropped once Cloudflare reported them stale (2026-11-16). Do not
  // declare a class here: a new agent gets its own Worker (packages/core/test/cutover-moves.test.ts fails if one appears).
  "exports": {},
}
