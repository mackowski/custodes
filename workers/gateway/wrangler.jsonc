{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "custodes-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Single environment. Local development uses the same config with miniflare-backed bindings.
  "routes": [{ "pattern": "custodes.work", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "prod",
    // Cloudflare Zero Trust team: https://ai-custodes.cloudflareaccess.com
    "ACCESS_TEAM": "ai-custodes",
    // Application Audience (AUD) tag of the Access application; from `terraform output`.
    "ACCESS_AUD": "0cb7808f9edd99f93ee4cb7ee333f46eb7ee2ad9cc8abd4a05667344cd8c595e",
    "EMAIL_DOMAIN": "custodes.work",
    // Comma-separated Access identities allowed to decide approvals (link page and CLI).
    "APPROVER_EMAILS": "jkb.mackowski@gmail.com",
  },
  // Secrets (set by CI on deploy): GITHUB_WEBHOOK_SECRET
  "kv_namespaces": [{ "binding": "KILL_SWITCH", "id": "841e2b0dd14d48fbac292217839957a4" }],
  "services": [
    // The broker's admin entrypoint (approvals, audit, keys); agents bind its default one, which
    // cannot decide approvals (ADR 0017 amendment).
    { "binding": "BROKER", "service": "custodes-github-broker", "entrypoint": "BrokerAdmin" },
    { "binding": "AGENTS", "service": "custodes-agents" },
    // triage and its specialists in their own Worker (ADR 0018, cutover 2026-11-12): /agents/* for
    // their classes goes here, and their keys page uses its KeyAdmin.
    { "binding": "TRIAGE", "service": "custodes-triage" },
    { "binding": "KEYS_TRIAGE", "service": "custodes-triage", "entrypoint": "KeyAdmin" },
    // pr-gate in its own Worker (ADR 0018, cutover): /agents/pr-gate-agent/* and its keys.
    { "binding": "PR_GATE", "service": "custodes-pr-gate" },
    { "binding": "KEYS_PR_GATE", "service": "custodes-pr-gate", "entrypoint": "KeyAdmin" },
    // cheatsheet-review in its own Worker (ADR 0018, cutover): /agents/cheatsheet-review-agent/*
    // and its keys.
    { "binding": "CHEATSHEET_REVIEW", "service": "custodes-cheatsheet-review" },
    {
      "binding": "KEYS_CHEATSHEET_REVIEW",
      "service": "custodes-cheatsheet-review",
      "entrypoint": "KeyAdmin",
    },
    // triage-apply's public keys and Rotate for /admin/agent-keys (ADR 0018, ADR 0019). It is a new
    // Worker deployed before the gateway, so the binding exists from the first deploy; the other
    // agents' KEYS_* bindings come with their cutovers.
    {
      "binding": "KEYS_TRIAGE_APPLY",
      "service": "custodes-triage-apply",
      "entrypoint": "KeyAdmin",
    },
  ],
  // Pull request events go to each agent's own queue: custodes-inbound-cheatsheet-review (its trigger
  // label) and custodes-inbound-pr-gate. custodes-inbound: the shared Worker, which acts on nothing
  // since the cutovers; the clean-up PR removes it. Each consumer ignores what is not for it.
  "queues": {
    "producers": [
      { "binding": "INBOUND", "queue": "custodes-inbound" },
      { "binding": "INBOUND_PR_GATE", "queue": "custodes-inbound-pr-gate" },
      { "binding": "INBOUND_CHEATSHEET_REVIEW", "queue": "custodes-inbound-cheatsheet-review" },
    ],
  },
}
